# Copy this file to .env and fill in every value:   cp .env.example .env
# NEVER upload .env to GitHub (it's already listed in .gitignore).
#
# Make strong passwords with:   openssl rand -hex 24
# Use letters and numbers only (no spaces, quotes or $) so the backup script can read them.

# ---- Database ----
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me

# ---- Nextcloud admin account ----
# Don't use "admin". It's the first username attackers try.
NEXTCLOUD_ADMIN_USER=change-me
NEXTCLOUD_ADMIN_PASSWORD=change-me

# ---- Tailscale ----
# Your server's full Tailscale name (shown on the Machines page of the Tailscale admin console)
TAILSCALE_HOSTNAME=musacloud.your-tailnet.ts.net

# ---- Backups: restic + Amazon S3 ----
# Format: s3:s3.REGION.amazonaws.com/BUCKET-NAME
RESTIC_REPOSITORY=s3:s3.us-east-1.amazonaws.com/your-bucket-name
# This password encrypts your backups. Save it in a password manager.
# If you lose it, your backups can never be opened.
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
